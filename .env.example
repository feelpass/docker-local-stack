# ============================================
# Global Port Configuration
# Copy this file to .env and customize as needed
# ============================================

# MySQL Ports
MYSQL_PORT=3306
PHPMYADMIN_PORT=8082

# Redis Ports
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8081

# DynamoDB Ports
DYNAMODB_PORT=8000
DYNAMODB_ADMIN_PORT=8001

# MongoDB Ports
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8083

# Kafka Ports
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8080

# LocalStack Port (AWS Services)
LOCALSTACK_PORT=4566

# Elasticsearch Ports
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# RabbitMQ Ports
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# AWS Configuration
# ============================================

# AWS Profiles Configuration
# You can define multiple profiles here
# Format: AWS_PROFILE_[NAME]_KEY and AWS_PROFILE_[NAME]_SECRET

# Profile: default
AWS_PROFILE_DEFAULT_KEY=local
AWS_PROFILE_DEFAULT_SECRET=local
AWS_PROFILE_DEFAULT_REGION=ap-northeast-2

# Profile: dev
AWS_PROFILE_DEV_KEY=dev-key
AWS_PROFILE_DEV_SECRET=dev-secret
AWS_PROFILE_DEV_REGION=ap-northeast-2

# Profile: staging
AWS_PROFILE_STAGING_KEY=staging-key
AWS_PROFILE_STAGING_SECRET=staging-secret
AWS_PROFILE_STAGING_REGION=us-west-2

# Profile: prod
AWS_PROFILE_PROD_KEY=prod-key
AWS_PROFILE_PROD_SECRET=prod-secret
AWS_PROFILE_PROD_REGION=us-east-1

# Current Active Profile Settings (automatically set by make aws-profile)
AWS_ACCESS_KEY_ID=${AWS_PROFILE_DEFAULT_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_PROFILE_DEFAULT_SECRET}
AWS_REGION=${AWS_PROFILE_DEFAULT_REGION}

# ============================================
# Database Configurations
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bomcalendar
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root123
MONGO_DATABASE=bomcalendar

# Redis
# REDIS_PASSWORD=redis123  # Uncomment to enable password

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123